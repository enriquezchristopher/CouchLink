<UserControl x:Class="CouchLink.App.Ui.TitleBar" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:CouchLink.App.Ui"
             Height="32" Focusable="False" IsTabStop="False">
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
        <DockPanel>
            <ui:CaptionButtons DockPanel.Dock="Right"/>
            <TextBlock x:Name="TitleText" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"
                       Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </DockPanel>
    </Border>
</UserControl>
