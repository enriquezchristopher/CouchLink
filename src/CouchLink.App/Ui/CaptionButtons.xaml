<UserControl x:Class="CouchLink.App.Ui.CaptionButtons" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" IsTabStop="False">
    <StackPanel Orientation="Horizontal">
        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="{StaticResource CaptionMinimizeGlyph}"
                AutomationProperties.Name="Minimize" AutomationProperties.AutomationId="CaptionMinimize"/>
        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="{StaticResource CaptionMaximizeGlyph}"
                AutomationProperties.Name="Maximize" AutomationProperties.AutomationId="CaptionMaximize"/>
        <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButton}" Content="{StaticResource CaptionCloseGlyph}"
                AutomationProperties.Name="Close" AutomationProperties.AutomationId="CaptionClose"/>
    </StackPanel>
</UserControl>
