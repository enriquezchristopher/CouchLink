<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CouchLink.Audio\CouchLink.Audio.csproj" />
    <ProjectReference Include="..\CouchLink.Core\CouchLink.Core.csproj" />
    <ProjectReference Include="..\CouchLink.Pads\CouchLink.Pads.csproj" />
    <ProjectReference Include="..\CouchLink.Video\CouchLink.Video.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The app's text is English only. Without this, a self-contained publish copies WPF's translated
         strings for 13 other languages (about 8 MB) next to the exe. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CouchLink.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Controller profiles shipped next to the exe; the controls editor lists them. -->
    <Content Include="profiles\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
