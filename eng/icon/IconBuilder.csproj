<Project Sdk="Microsoft.NET.Sdk">

  <!-- Regenerates assets/couchlink.ico and assets/social-preview.png from the SVGs in assets/.
       Not part of CouchLink.slnx. Run it by hand: dotnet run, with the project eng/icon. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Svg.Skia" Version="3.0.3" />
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
  </ItemGroup>

</Project>
